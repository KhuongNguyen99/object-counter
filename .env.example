# Frontend website
PORT=8080
BIND_ADDRESS=0.0.0.0
# Backend API; localhost-only by default
API_PORT=8082
API_BIND_ADDRESS=127.0.0.1
DEVICE=auto
OMP_NUM_THREADS=4
# Frontend server proxy destination (backend origin, no API path)
BACKEND_URL=http://counter:8080
# Optional browser-to-backend URL; empty uses the frontend proxy
API_BASE_URL=
# Required only for direct requests from another browser origin; comma-separated
FRONTEND_ORIGINS=

# Model execution: local or runpod
INFERENCE_BACKEND=local
# RunPod credentials stay in this private .env, never in the browser
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TIMEOUT_SECONDS=600
RUNPOD_BENCHMARK_BUDGET_USD=5.00
