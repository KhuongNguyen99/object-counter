# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DATA_DIR=/app/data INFERENCE_BACKEND=runpod
WORKDIR /app
RUN groupadd --gid 10001 counter && useradd --uid 10001 --gid counter --create-home counter
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY app /app/app
RUN mkdir -p /app/data && chown counter:counter /app/data
USER counter
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--limit-concurrency", "32"]
