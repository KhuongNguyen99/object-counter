# Build countwell-backend:runpod-base from Dockerfile with the CUDA 12.8 torch index first.
ARG WORKER_BASE_IMAGE=countwell-backend:runpod-base
FROM ${WORKER_BASE_IMAGE}

ARG WORKER_BUILD_REVISION=unknown
ENV WORKER_BUILD_REVISION=${WORKER_BUILD_REVISION}

USER root
COPY requirements-runpod.txt /app/requirements-runpod.txt
RUN pip install -r /app/requirements-runpod.txt \
    && chmod -R a+rX /app/models /opt/countgd
COPY app /app/app
COPY scripts /app/scripts
USER counter

HEALTHCHECK NONE
CMD ["python", "-m", "app.runpod_worker"]
